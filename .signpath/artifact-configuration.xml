<?xml version="1.0" encoding="utf-8"?>
<!--
  The artifact configuration of the SignPath project that signs the Windows
  installer. SignPath keeps its own copy: paste this into the project's
  artifact configuration (slug "windows-installer") after changing it here.

  The release workflow (sign-windows job) hands SignPath the
  anchor-desktop-windows artifact, a zip holding Anchor-Setup-<version>.exe,
  with the version parameter set to <app version>.<run>, the four-part
  version electron-builder writes into the installer (-c.buildNumber).
  SignPath Foundation requires the product name and version to be checked.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Anchor-Setup-*.exe" product-name="Anchor+" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
