      "name": {
        "type": "String",
        "example": "voice-memo.m4a"
      }
    }
  },
  "commonPauseItem": "Pause {name}",
  "@commonPauseItem": {
    "description": "Screen reader label of a pause button for an audio or video file.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "voice-memo.m4a"
      }
    }
  },
  "commonSwitchOn": "{label}, on",
