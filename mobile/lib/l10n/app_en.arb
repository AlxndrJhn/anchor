      "count": {
        "type": "int",
        "example": "8"
      }
    }
  },
  "settingsSignOutMessage": "{count, plural, =0{Your notes stay on this phone and sync again when you sign in.} =1{1 change hasn’t synced yet. It stays on this phone and syncs when you sign in again.} other{{count} changes haven’t synced yet. They stay on this phone and sync when you sign in again.}}",
  "@settingsSignOutMessage": {
    "description": "{count} is the number of changes not yet sent to the server.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "logsCopied": "{count, plural, =1{1 log copied} other{{count} logs copied}}",
  "@logsCopied": {
    "description": "Toast after the selected logs were copied.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
